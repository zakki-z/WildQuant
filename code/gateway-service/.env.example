SPRING_DATASOURCE_URL=jdbc:postgresql://postgres:5432/wildquants
SPRING_DATASOURCE_USERNAME=wildquants
SPRING_DATASOURCE_PASSWORD=changeme

# Spring JPA — set to "validate" in production once schema is stable
SPRING_JPA_HIBERNATE_DDL_AUTO=update

# JWT secret for API auth (min 32 chars)
JWT_SECRET=replace_with_a_long_random_secret_string
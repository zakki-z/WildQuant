# Secrets — never send to build context
.env
*.pem
*.key
*.cert


# Git
.git
.gitignore
.gitattributes


# Node / Frontend
code/frontend/node_modules
code/frontend/.next
code/frontend/out
code/frontend/.cache


# Java / Maven
code/gateway-service/target
code/gateway-service/.mvn/wrapper/maven-wrapper.jar
**/*.class


# Python
code/agent-service/__pycache__
code/agent-service/**/__pycache__
code/agent-service/.venv
code/agent-service/venv
code/agent-service/.pytest_cache
**/*.pyc
**/*.pyo
**/*.pyd



# ML artefacts — large files, not needed at build time
**/*.pt
**/*.pth
**/*.bin
**/*.onnx
**/*.safetensors
code/agent-service/models

# Infra / Docker — no need to send Dockerfiles
infra
docker.compose.yaml

# IDEs and OS noise
.idea
.vscode
*.iml
.DS_Store
Thumbs.db

# Docs and markdown — not needed in images
*.md
docs
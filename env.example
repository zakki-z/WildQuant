# ─────────────────────────────────────────────
# WildQuants — Environment Variables
# Copy this file to .env and fill in the values
# Never commit .env to version control
# ─────────────────────────────────────────────


# ─────────────────────────────────────────────
# Postgres
# ─────────────────────────────────────────────
POSTGRES_USER=wildquants
POSTGRES_PASSWORD=changeme
POSTGRES_DB=wildquants


# ─────────────────────────────────────────────
# Gateway Service — Spring Boot
# ─────────────────────────────────────────────
SPRING_DATASOURCE_URL=jdbc:postgresql://postgres:5432/wildquants
SPRING_DATASOURCE_USERNAME=wildquants
SPRING_DATASOURCE_PASSWORD=changeme

# Spring JPA — set to "validate" in production once schema is stable
SPRING_JPA_HIBERNATE_DDL_AUTO=update

# JWT secret for API auth (min 32 chars)
JWT_SECRET=replace_with_a_long_random_secret_string


# ─────────────────────────────────────────────
# Agent Service — Python / FastAPI
# ─────────────────────────────────────────────
DATABASE_URL=postgresql://wildquants:changeme@postgres:5432/wildquants

# Hugging Face model access
HUGGINGFACE_TOKEN=hf_replace_with_your_token

# Model to load — swap for FinGPT or Llama-3-finance on AMD cloud
MODEL_NAME=ProsusAI/finbert

# Set to "cuda" on AMD Developer Cloud, "cpu" for local dev without GPU
DEVICE=cpu


# ─────────────────────────────────────────────
# Frontend — Next.js
# NEXT_PUBLIC_ prefix exposes variables to the browser bundle
# Non-prefixed variables are server-side only (SSR/API routes)
# ─────────────────────────────────────────────

# Used by Next.js server-side (SSR / API routes) to call the gateway
GATEWAY_URL=http://gateway-service:8080

# Used by the browser to call the gateway directly (client-side fetches)
NEXT_PUBLIC_GATEWAY_URL=http://localhost:8080


# ─────────────────────────────────────────────
# Market Data
# ─────────────────────────────────────────────

# Alpaca paper trading — get free keys at alpaca.markets
ALPACA_API_KEY=replace_with_your_key
ALPACA_SECRET_KEY=replace_with_your_secret
ALPACA_BASE_URL=https://paper-api.alpaca.markets

# Reddit API — get keys at reddit.com/prefs/apps
REDDIT_CLIENT_ID=replace_with_your_client_id
REDDIT_CLIENT_SECRET=replace_with_your_client_secret
REDDIT_USER_AGENT=wildquants/0.1

# Optional: News API for sentiment (newsapi.org free tier)
NEWS_API_KEY=replace_with_your_key
